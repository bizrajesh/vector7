APP_NAME=vector7
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://vector7.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB 10.6+ (Laragon default user is root with an empty password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vector7
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true on the live (HTTPS) server
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Laragon: "log" writes emails to storage/logs. Hostinger: use smtp (see README)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@vector7.in"
MAIL_FROM_NAME="vector7"

# First App Admin (Super Admin) created by "php artisan migrate --seed"
APP_ADMIN_NAME="Vector7 Admin"
APP_ADMIN_EMAIL=admin@vector7.in
APP_ADMIN_PASSWORD="ChangeMe@2026"

# Seed the demo tenant (Demo Promoters, Thanjavur) with sample data
SEED_DEMO=true

# Search engines: on staging set to false (robots.txt disallows everything + noindex)
SEO_INDEXABLE=true

# Force https:// links (set true on Hostinger)
FORCE_HTTPS=false
