APP_NAME=Vector7
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://www.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Comma-separated proxy IPs/CIDRs you trust for X-Forwarded-* (e.g. Cloudflare). Leave empty if none.
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_xaxis
DB_USERNAME=cpaneluser_xaxis
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Subscription payments (Razorpay). Leave empty to run sign-ups as trial-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (optional). Only graph.facebook.com is ever called.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

XAXIS_SUPPORT_EMAIL=support@example.com
XAXIS_REQUIRE_EMAIL_VERIFICATION=true
